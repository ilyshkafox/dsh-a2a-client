{
  "name": "@local/dsh-a2a-client",
  "version": "1.5.1",
  "private": true,
  "type": "module",
  "description": "Клиент A2A (Agent2Agent) для DSH: подключается к удалённому агенту по его AgentCard, даёт модели инструменты для обмена сообщениями и страницу «Настройки → A2A».",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "react"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}










